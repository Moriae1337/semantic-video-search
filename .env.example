# Copy to .env and edit. Every setting in src/svs/config.py can be set as SVS_<NAME>.
SVS_DATA_DIR=data
SVS_SEGMENT_SECONDS=5.0
SVS_FRAMES_PER_SEGMENT=4
SVS_MODEL_NAME=ViT-B-32
SVS_MODEL_PRETRAINED=laion2b_s34b_b79k
SVS_DEVICE=auto
SVS_EMBED_BATCH_SIZE=64
SVS_VECTOR_MODE=segment
SVS_QDRANT_URL=http://localhost:6333
